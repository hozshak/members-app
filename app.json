{
  "expo": {
    "name": "THFM",
    "slug": "members",
    "owner": "en0o0n",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "members",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.en0o0n.members",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.en0o0n.members",
      "adaptiveIcon": {
        "backgroundColor": "#E3A79D",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4F1",
          "image": "./assets/images/icon-preview-rose.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#121110"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Für deine Fortschrittsfotos braucht die App die Frontkamera. Die Fotos bleiben nur auf deinem Handy.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du ein Profilfoto aus deinen Fotos auswählen kannst.",
          "cameraPermission": "Für deine Fortschrittsfotos braucht die App die Frontkamera.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D98F83"
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Damit nur du deine Fortschrittsfotos sehen kannst."
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "RoutineWidget",
              "displayName": "Routine",
              "description": "Deine Serie und die Routine von heute.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/routine-widget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "initialLayout": "src/widgets/routine-widget.android.tsx"
              }
            },
            {
              "name": "CheckInWidget",
              "displayName": "Check-in",
              "description": "Wann dein nächster Check-in kommt.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/check-in-widget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "initialLayout": "src/widgets/check-in-widget.android.tsx"
              }
            },
            {
              "name": "TongueWidget",
              "displayName": "Zunge",
              "description": "Wo ist deine Zunge gerade? Die kleine Erinnerung für den Sperrbildschirm.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemSmall"
                ],
                "initialLayout": "src/widgets/tongue-widget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "initialLayout": "src/widgets/tongue-widget.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-asset",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Gold",
            "ios": "./assets/images/icon-gold.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-gold-foreground.png",
              "backgroundColor": "#E3A79D"
            }
          }
        ]
      ],
      "expo-mail-composer",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.en0o0n.members.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.en0o0n.members"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6d13e098-efe4-422b-980d-54a8a3700996"
      }
    }
  }
}
